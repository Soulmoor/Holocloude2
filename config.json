        "use_home_assistant": true,
        "fallback_to_simulation": true
    },

    "network": {
        "ollama": {
            "host": "http://192.168.178.42:11434",
            "local_host": "http://192.168.178.42:11434",
            "remote_host": "http://192.168.178.42:11434"
        },
        "mqtt": {
            "broker_ip": "192.168.178.99",
            "broker_port": 1883,
            "username": "",
            "password": "",
            "base_topic": "holocloude",
            "topic_prefix": "holo"
        },
        "home_assistant": {
            "api_url": "http://192.168.178.99:8123/api",
            "token": "",
            "api_token": "",
            "weather_entity": "weather.home",
            "calendar_entity": "calendar.personal"
        },
        "nas": {
            "ip": "192.168.178.40",
            "mac": "",
            "ssh_user": "admin",
            "ssh_port": 22,
            "path": "/volume1/media",
            "list_subfolders": true
        },
        "comfyui": {
            "host": "192.168.1.100",
            "port": 8188
        }
    },

    "health_checks": {
        "health_timeout_ollama": 10,
        "health_timeout_mqtt": 5,
        "health_timeout_ha": 10,
        "health_timeout_nas": 15,
        "health_timeout_db": 5
    },

    "system_monitoring": {
        "cpu_busy_threshold": 80,
        "memory_warning_mb": 500,
        "memory_critical_mb": 200,
        "disk_warning_percent": 80,
        "disk_critical_percent": 95,
        "include_cpu": true,
        "include_ram": true,
        "include_disk": true,
        "include_temperature": true,
        "include_size": true
    },

    "devices": {
        "tracked_devices": {
            "tv_wohnzimmer": "192.168.178.29",
            "workstation_pc": "192.168.178.31",
            "tablet_kira": "192.168.178.35",
            "kira_phone": "192.168.178.34"
        },
        "wake_detection_devices": ["tv_wohnzimmer", "workstation_pc"],
        "media_sources": [
            {"name": "nas", "display_name": "NAS", "ip": "192.168.178.100", "type": "nas"},
            {"name": "mini-pc", "display_name": "Mini-PC", "ip": "192.168.178.102", "type": "pc"},
            {"name": "pi", "display_name": "Raspberry Pi", "ip": "192.168.178.103", "type": "pi"}
        ],
        "rooms": {
            "wohnzimmer": ["tv_wohnzimmer", "workstation_pc"],
            "schlafzimmer": ["kira_phone", "tablet_kira"]
        },
        "device_defaults": {
            "icon": "mdi:devices",
            "type": "generic",
            "hostname": "",
            "location": "unknown",
            "display_name": "",
            "description": "",
            "role": "secondary",
            "idle_timeout_minutes": 30,
            "can_wake": false,
            "can_sleep": false
        }
    },

    "llm": {
        "local_model": "nemotron-3-nano:latest",
        "remote_model": "nemotron-3-nano:latest",
        "fallback_model": "nemotron-3-nano:latest",
        "embedding_model": "nomic-embed-text",
        "max_context_tokens": 8192,
        "temperature": 0.7,
        "timeout_seconds": 120
    },

    "behavior": {
        "bedtime_reminder_hour": 23,
        "wake_up_hour": 7,
        "energy_save_start_hour": 23,
        "energy_save_end_hour": 6,
        "mood_tendency": "neutral",
        "response_type": "balanced",
        "quick_response": false,
        "energy_saving": false,
        "energy_mult": 1.0,
        "stability": 0.8,
        "responsiveness": 0.7,
        "cognitive_load": 0.5,
        "user_comfort": 0.8
    },

    "activities": {
        "defaults": {
            "weight": 1.0,
            "time_required": 5,
            "suitable_for": ["all"],
            "triggers": [],
            "steps": [],
            "keywords": [],
            "actors": [],
            "capabilities": [],
            "patterns": [],
            "hours": [0, 24],
            "optimal": "anytime",
            "impulse": 0.5,
            "learning": true,
            "prompt": ""
        }
    },

    "watchlist": {
        "news_topics": ["Russland", "Ukraine", "KI", "Klimawandel", "USA", "China", "Deutschland"],
        "priority_sources": ["tagesschau", "zeit", "spiegel"]
    },

    "storage": {
        "data_dir": "data",
        "db_file": "holo_brain_v12.db",
        "knowledge_db": "holo_knowledge.db",
        "max_core_storage_gb": 4,
        "max_knowledge_storage_gb": 10,
        "cleanup_enabled": false,
        "ram_cache_mb": 500,
        "sd_storage_gb": 16
    },

    "paths": {
        "_comment": "Zentrale Pfadkonfiguration - relative Pfade sind relativ zum Projektverzeichnis",
        "data_dir": "data",
        "logs_dir": "logs",
        "databases": {
            "main": "data/holo_brain_v12.db",
            "memory": "data/holo_memory.db",
            "emotions": "data/holo_emotions.db",
            "identity": "data/holo_identity.db",
            "language": "data/holo_language.db",
            "knowledge": "data/holo_knowledge.db",
            "media": "data/holo_media.db",
            "news": "data/holo_news.db",
            "conversations": "data/holo_conversations.db",
            "activity": "data/holo_activity.db",
            "productivity": "data/holo_productivity.db",
            "environment": "data/holo_environment.db",
            "network": "data/holo_network.db",
            "presence": "data/holo_presence.db",
            "home": "data/holo_home.db",
            "calendar": "data/holo_calendar.db",
            "predictions": "data/holo_predictions.db",
            "state": "data/holo_state.db",
            "skills": "data/holo_skills.db",
            "music": "data/holo_music.db",
            "media_index": "data/media_index.db",
            "device_registry": "data/device_registry.db"
        },
        "subdirs": {
            "journal": "data/journal",
            "connections": "data/connections",
            "knowledge": "data/knowledge",
            "media": "data/media",
            "histories": "data/histories",
            "local_understanding": "data/local_understanding",
            "music": "data/holo_music",
            "energy_management": "data/energy_management",
            "cognitive_enhancement": "data/cognitive_enhancement",
            "offloaded": "data/offloaded",
            "cache": "data/cache"
        },
        "files": {
            "error_log": "data/error_log.json",
            "disk_index": "data/disk_index.json"
        }
    },

    "logging": {
        "level": "INFO",
        "file": "logs/holocloude.log",
        "max_size_mb": 10,
        "backup_count": 5
    },

    "features": {
        "enable_voice": true,
        "enable_media_discovery": true,
        "enable_proactive_messages": true,
        "enable_autonomous_activity": true,
        "enable_web_curiosity": true,
        "enable_discord": true,
        "enable_emotional_engines": true,
        "enable_humor_engine": true,
        "enable_emotional_complexity": true,
        "enable_emotional_mirroring": true,
        "enable_negative_behaviors": true,
        "enable_sarcasm": true
    },

    "discord": {
        "_comment": "Discord Bot Konfiguration - Token NICHT committen!",
        "token": "",
        "allowed_user_ids": [],
        "allowed_channel_ids": [],
        "command_prefix": "!",
        "proactive_enabled": true,
        "proactive_dm_user_id": 0,
        "proactive_check_interval": 60,
        "typing_enabled": true,
        "typing_delay_per_char": 0.03,
        "typing_max_delay": 5.0,
        "min_response_interval": 1.0,
        "status_message": "Holo ist da! 💕"
    },

    "presence_rules": [
        {
            "name": "Gaming_Session",
            "time_range": [18, 2],
            "conditions": {"workstation_pc_online": true},
            "result_zone": "wohnzimmer"
        },
        {
            "name": "TV_Abend",
            "time_range": [19, 24],
            "conditions": {"tv_wohnzimmer_online": true},
            "result_zone": "wohnzimmer"
        },
        {
            "name": "Night_Mode",
            "time_range": [22, 7],
            "conditions": {"tv_wohnzimmer_online": false, "workstation_pc_online": false},
            "result_zone": "schlafzimmer"
        }
    ]
}
